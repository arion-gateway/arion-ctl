#!/bin/sh
export RELEASE_DISTRIBUTION=sname
export RELEASE_NODE="${RELEASE_NODE:-arionctl}"

# The VM sizes its port table from the open-files limit, which some container
# runtimes set near a billion: that costs about 2 GB before the service starts.
# 65536 ports is far more than the service opens.
export ERL_MAX_PORTS="${ERL_MAX_PORTS:-65536}"
