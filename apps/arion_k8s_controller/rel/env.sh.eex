#!/bin/sh
# Distributed Erlang: each pod is arion@<pod-ip>. Only the booting node listens on
# the fixed ERL_DIST_PORT; rpc/remote/stop/pid start a hidden peer in the same pod,
# which takes an ephemeral port.
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="${RELEASE_NODE:-arion@${POD_IP}}"

# The VM sizes its port table from the open-files limit, which some container
# runtimes set near a billion: that costs about 2 GB before the application
# starts. 65536 ports is far more than the controller opens.
export ERL_MAX_PORTS="${ERL_MAX_PORTS:-65536}"

case $RELEASE_COMMAND in
  start*|daemon*)
    export ERL_AFLAGS="${ERL_AFLAGS:-} -kernel inet_dist_listen_min ${ERL_DIST_PORT:-9100} inet_dist_listen_max ${ERL_DIST_PORT:-9100}"
    ;;
esac
